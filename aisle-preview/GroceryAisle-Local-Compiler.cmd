@echo off
setlocal DisableDelayedExpansion
set "AISLE_COMPANION_LAUNCHER=%~f0"
powershell.exe -NoLogo -NoProfile -Command "$t=[IO.File]::ReadAllText($env:AISLE_COMPANION_LAUNCHER); $s=[regex]::Split($t,'(?m)^::AISLE_POWERSHELL_START::\r?$'); if($s.Count -ne 2){exit 1}; & ([ScriptBlock]::Create($s[1]))"
exit /b %errorlevel%
::AISLE_POWERSHELL_START::
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
Add-Type -AssemblyName System.IO.Compression.FileSystem
$base = Join-Path $env:LOCALAPPDATA 'GroceryAisleCompiler'
$dist = Join-Path $base 'downloads'
$packages = Join-Path $base 'tools'
$kitHash = '0e64da38b890545d51134ac1bf1d420968fb41822f3f2db9256cee3c716855db'
$brokerHash = '473b37b9a9ea727e1dfbf9039d418c9382279b85b1089a48f506fbcef0989a9a'
$site = 'https://olympusmajoris-star.github.io'
$zipUrl = $site + '/sleipnir-ai/aisle-preview/compiler-kit.zip'
$flutterHash = 'dd965ac84db435225eea9c55430de262770728617d4df57a370ffc56f2591077'
$pythonHash = '91d828c2da3a029b41699e918674a0cb379c02cf20dab9c501306885f837402a'
$gitHash = '4a92850b6e917da4fd010669b614b55dccf5b0ec333a534cc4be4700dfefdafd'
function Require-Yes([string]$prompt) {
    if ((Read-Host "$prompt [y/N]").Trim().ToLowerInvariant() -notin @('y','yes')) {
        throw 'Setup was cancelled.'
    }
}
function Install-PackageZip([string]$name, [string]$url, [string]$hash, [string]$testFile) {
    $target = Join-Path $packages "$name-$($hash.Substring(0,12))"
    $testPath = Join-Path $target $testFile
    if ((Test-Path -LiteralPath $testPath -PathType Leaf) -and
        (Test-Path -LiteralPath (Join-Path $target '.verified-install'))) { return $target }
    $zip = Join-Path $dist "$hash.zip"
    if (!(Test-Path -LiteralPath $zip -PathType Leaf)) {
        $partial = "$zip.$PID.download"
        Write-Host "Downloading $name ..."
        try {
            (New-Object Net.WebClient).DownloadFile($url,$partial)
            if ((Get-FileHash -Algorithm SHA256 -LiteralPath $partial).Hash.ToLowerInvariant() -ne $hash) {
                throw "$name download failed SHA-256 verification."
            }
            Move-Item -LiteralPath $partial -Destination $zip
        } finally { if (Test-Path -LiteralPath $partial) { Remove-Item -LiteralPath $partial -Force } }
    }
    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash.ToLowerInvariant() -ne $hash) {
        throw "Cached $name download differs from its pinned SHA-256. Remove $zip and run this launcher again."
    }
    $stage = Join-Path $packages ([guid]::NewGuid().ToString('N'))
    try {
        Write-Host "Extracting $name ..."
        [IO.Compression.ZipFile]::ExtractToDirectory($zip,$stage)
        if (!(Test-Path -LiteralPath (Join-Path $stage $testFile) -PathType Leaf)) { throw "Missing expected $name executable or script." }
        [IO.File]::WriteAllText((Join-Path $stage '.verified-install'),$hash)
        if (Test-Path -LiteralPath $target) { throw "The managed $name directory is incomplete. Rename $target and run again." }
        [IO.Directory]::Move($stage,$target)
    } finally { if (Test-Path -LiteralPath $stage) { Remove-Item -LiteralPath $stage -Recurse -Force } }
    return $target
}
try {
    if (![Environment]::Is64BitOperatingSystem) { throw 'This launcher requires 64-bit Windows.' }
    if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64') {
        throw 'This download contains x64 tools. Use an x64 Windows PC for the local compiler.'
    }
    try {
        $ping=Invoke-RestMethod -Uri 'http://127.0.0.1:48179/health' -Headers @{Origin=$site} -TimeoutSec 1
        if ($ping.ready -eq $true -and $ping.version -eq 1) {
            Start-Process 'http://127.0.0.1:48179/'
            exit 0
        }
    } catch {}
    foreach ($dir in @($base,$dist,$packages)) { [void][IO.Directory]::CreateDirectory($dir) }
    $identity=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value
    & icacls.exe $base '/inheritance:r' '/grant:r' ("*"+$identity+':(OI)(CI)F') '*S-1-5-18:(OI)(CI)F' | Out-Null
    if ($LASTEXITCODE -ne 0) { throw 'Could not protect the owner-local compiler directory.' }
    $marker = Join-Path $base ".approved-$kitHash"
    if (!(Test-Path -LiteralPath $marker)) {
        Write-Host 'GroceryAisle local compiler for Windows (x64)'
        Write-Host "Installation folder: $base"
        Require-Yes 'Install this verified compiler kit and its private Python runtime on this PC?'
    }
    $pyDir = Install-PackageZip 'python-3.13.9' 'https://www.python.org/ftp/python/3.13.9/python-3.13.9-embed-amd64.zip' $pythonHash 'python.exe'
    $python = Join-Path $pyDir 'python.exe'
    $kit = Install-PackageZip 'aisle-compiler' $zipUrl $kitHash 'build.py'
    $flutter = $null
    $installed = Get-Command 'flutter.bat' -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
    $git = Get-Command 'git.exe' -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($installed -and $git) {
        try {
            $version = (& $installed.Source --version --machine 2>$null | Out-String | ConvertFrom-Json).frameworkVersion
            if ($version -eq '3.38.3') { $flutter = $installed.Source }
        } catch {}
    }
    if (!$flutter) {
        $sdkTest=Join-Path $packages "flutter-3.38.3-$($flutterHash.Substring(0,12))\flutter\bin\flutter.bat"
        if (!(Test-Path -LiteralPath $sdkTest -PathType Leaf) -or (!$git -and !(Test-Path -LiteralPath (Join-Path $packages "mingit-$($gitHash.Substring(0,12))\cmd\git.exe")))) {
            Require-Yes 'Install the pinned Flutter 3.38.3 SDK (a large download) and, if needed, portable Git in this private folder?'
        }
        if (!$git) {
            $gitDir=Install-PackageZip 'mingit' 'https://github.com/git-for-windows/git/releases/download/v2.56.1.windows.1/MinGit-2.56.1-64-bit.zip' $gitHash 'cmd\git.exe'
            $env:PATH=(Join-Path $gitDir 'cmd')+';'+$env:PATH
        }
        $sdk=Install-PackageZip 'flutter-3.38.3' 'https://storage.googleapis.com/flutter_infra_release/releases/stable/windows/flutter_windows_3.38.3-stable.zip' $flutterHash 'flutter\bin\flutter.bat'
        $flutter=Join-Path $sdk 'flutter\bin\flutter.bat'
    }
    $env:CI='true';$env:FLUTTER_SUPPRESS_ANALYTICS='true';$env:DART_SUPPRESS_ANALYTICS='true'
    $env:PUB_CACHE=Join-Path $base 'pub-cache'
    $ready=Join-Path $base ".web-ready-$kitHash"
    if (!(Test-Path -LiteralPath $ready)) {
        Write-Host 'Preparing Flutter web support ...'
        & $flutter precache --web
        if ($LASTEXITCODE -ne 0) { throw 'Flutter web preparation failed.' }
        [IO.File]::WriteAllText($ready,'3.38.3')
    }
    $broker=Join-Path $base ('broker-'+$brokerHash+'.py')
    $bytes=[Convert]::FromBase64String('')
    $calculated=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($bytes)).Replace('-','').ToLowerInvariant()
    if ($calculated -ne $brokerHash) { throw 'Embedded companion verification failed.' }
    [IO.File]::WriteAllBytes($broker,$bytes)
    [IO.File]::WriteAllText($marker,$kitHash)
    Write-Host 'Open GroceryAisle Studio and select Pair local compiler. Keep this console open while editing.'
    & $python $broker --compiler (Join-Path $kit 'build.py') --flutter $flutter --cache (Join-Path $base 'compiler-cache')
    if ($LASTEXITCODE -ne 0) { throw 'The local compiler stopped with an error.' }
} catch {
    Write-Host ("GroceryAisle compiler: " + $_.Exception.Message) -ForegroundColor Red
    [void](Read-Host 'Press Enter to close')
    exit 1
}
